# 仅本机local profile示例。由本机launcher生成并注入真实随机值，不提交生成配置。
# 建议实际使用项目内绝对路径；本示例相对mword-server工作目录。
MW_LOCAL_DB_URL=jdbc:h2:file:./.local/mword;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_ON_EXIT=FALSE
# 必填随机值；重启时保留原值，禁止每次重新生成。
MW_LOCAL_DB_PASSWORD=
MW_KEY_ENCRYPTION_SECRET=
MW_PORT=18081
MW_AI_WORKER_ENABLED=false
# 可选，无默认管理员密码。
MW_ADMIN_USERNAME=
MW_ADMIN_PASSWORD=
