# 仅示例，勿提交真实密码/API Key。启动前通过环境注入；Spring不会自动加载此文件。
MW_DB_URL=jdbc:mysql://localhost:3306/mword?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
MW_DB_USERNAME=mword
MW_DB_PASSWORD=
MW_PORT=18081
MW_SECURE_COOKIE=true
MW_REGISTRATION_ENABLED=true
MW_INITIAL_QUOTA=30
MW_SESSION_DAYS=30
MW_ALLOWED_ORIGINS=https://www.mayuanfei.com,http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost,http://localhost
# 运行openssl rand -base64 32生成，独立安全保存；变更后已有加密Key将无法解密。
MW_KEY_ENCRYPTION_SECRET=
# 可选初始化管理员，无默认生产密码；至少12字符且最多72 UTF-8字节。
MW_ADMIN_USERNAME=
MW_ADMIN_PASSWORD=
MW_PROVIDER_HOSTS=api.deepseek.com,api.siliconflow.cn,open.bigmodel.cn,dashscope.aliyuncs.com,api.moonshot.cn,ark.cn-beijing.volces.com
MW_COST_EXPLAIN=1
MW_COST_MEMORY=1
MW_COST_CONTEXT=1
MW_COST_ARTICLE=3
MW_AI_WORKER_ENABLED=true
MW_AI_REQUEST_TIMEOUT_SECONDS=55
